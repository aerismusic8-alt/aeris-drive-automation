{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aerismusic8://ax-control-hub/command.schema.json",
  "title": "AX Control Hub Command Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "idempotency_key", "actor", "command", "args", "requested_at"],
  "properties": {
    "request_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 128},
    "actor": {"type": "string", "enum": ["K", "SERVICE"]},
    "command": {"type": "string", "minLength": 1, "maxLength": 128},
    "args": {"type": "object"},
    "requested_at": {"type": "string", "format": "date-time"}
  }
}
