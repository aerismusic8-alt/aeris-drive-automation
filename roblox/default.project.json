{
  "name": "AXArena",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "AXArenaServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "AXArenaClient": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [
          0.12,
          0.12,
          0.16
        ],
        "Brightness": 1.6,
        "ClockTime": 15.5,
        "GlobalShadows": false,
        "OutdoorAmbient": [
          0.35,
          0.35,
          0.4
        ],
        "Technology": "Voxel"
      }
    }
  }
}
