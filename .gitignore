AKATH_CORE/runtime/runtime-registry.json
AKATH_CORE/runtime/runtime-state.json
AKATH_CORE/runtime/evidence.jsonl

# Vendored tooling (fetch with scripts/install-luau.sh)
tools/

# aeris938-1 pipeline: generated assets and renders are large; manifests are kept.
aeris938-1/work/
aeris938-1/library/img/*.png
aeris938-1/library/img/*.jpg
aeris938-1/library/music/*.mp3
aeris938-1/library/covers/*.png
!aeris938-1/library/*/manifest.json

# Python bytecode from the aeris938-1 pipeline
aeris938-1/**/__pycache__/
*.pyc
aeris938-1/dist/

# music938-1: generated audio, video, covers and caches are large; scripts,
# lyrics, tests and the manifests are tracked.
# Ignore the contents, not the directory: git cannot re-include a file inside an
# ignored directory, and the release ledger below must survive a clone.
music938-1/work/*
# The release ledger is the only record of what is already on YouTube, and
# release.py writes it under work/. If it is ignored, a fresh clone re-uploads
# every song as a duplicate.
!music938-1/work/release-state.json
# Same reason as the ledger: this is the list of clips that shipped broken and
# still need replacing, and it is only useful to a session that can read it.
!music938-1/work/pending-replacements.json
music938-1/library/songs/*.mp3
music938-1/library/songs/*.wav
music938-1/library/songs/stems-*/
music938-1/library/covers/*.png
music938-1/library/karaoke/*.mp4
!music938-1/library/*/manifest.json
music938-1/**/__pycache__/

# Shorts, thumbnails and cover jpgs are regenerable renders; the durable copy
# lives in the GitHub Release (see the 24h release mechanism).
music938-1/library/shorts/*.mp4
music938-1/library/thumbs/*.png
music938-1/library/covers/*.jpg
