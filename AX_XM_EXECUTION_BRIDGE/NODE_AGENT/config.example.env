# Copy to a local secret/config store on the execution node.
# NEVER commit the real values.
AX_BRIDGE_BASE_URL=https://ax-control-runtime.aerismusic8.workers.dev
AX_BRIDGE_TOKEN=REPLACE_LOCALLY
ACCOUNT_SCOPE=XM_MICRO_K_DESIGNATED_ACCOUNT
LIVE_EXECUTION_ENABLED=false
KILL_SWITCH=true
POLL_SECONDS=2
REQUEST_TIMEOUT_MS=1500

# AX_BRIDGE_TOKEN must match the Cloudflare Worker secret AX_XM_NODE_SECRET.
# Broker login credentials remain local to MT5 and are never sent to AX/GitHub.
