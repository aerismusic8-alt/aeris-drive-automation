{
  "version": "1.0",
  "name": "AX_TEMPORARY_GPT_BRIDGE",
  "status": "ACTIVE",
  "purpose": "Temporarily wake AX while K still uses ChatGPT as the control and observation channel.",
  "lifecycle": {
    "start_condition": "K_HAS_NOT_COMPLETED_AX_EXIT_FROM_GPT",
    "stop_condition": "AX_INDEPENDENT_EXECUTION_VERIFIED",
    "after_stop": "DISABLE_THEN_CLEANUP_ALL_GPT_BRIDGE_TRIGGERS_AND_STALE_COMMANDS"
  },
  "independence_rule": {
    "chatgpt_is_control_channel_only": true,
    "chatgpt_availability_is_not_ax_execution_state": true,
    "ax_must_continue_when_chatgpt_is_limited_or_offline": true,
    "trigger_must_not_call_chatgpt_to_make_progress": true
  },
  "wake_policy": {
    "heartbeat_minutes": 5,
    "event_driven_enabled": true,
    "max_concurrent_cycles": 1,
    "skip_if_previous_cycle_running": true,
    "retry_backoff_seconds": [30, 60, 120],
    "max_cycle_minutes": 5
  },
  "command_safety": {
    "durable_command_id_required": true,
    "idempotency_required": true,
    "terminal_states_are_never_retriggered": true,
    "stale_or_unused_commands_must_be_cleaned": true,
    "no_task_loss": true,
    "no_unverified_status_as_fact": true
  },
  "financial_guard": {
    "financial_execution_enabled": false,
    "live_trading_requires_k": true
  },
  "cleanup_checklist": [
    "disable_gpt_bridge_schedule",
    "disable_gpt_bridge_workflow_dispatch",
    "drain_or_explicitly_close_stale_commands",
    "verify_no_duplicate_wake_triggers",
    "verify_ax_independent_wake_path",
    "verify_chatgpt_is_not_an_execution_dependency"
  ]
}
