        "EnvironmentDiffuseScale": 0.55,
        "EnvironmentSpecularScale": 0.35
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Color": [
            0.78,
            0.85,
            0.95
          ],
          "Decay": [
            0.35,
            0.5,
            0.7
          ],
